# Workspace Fiscal - Variáveis de ambiente (opcionais)

# PORT: Porta do servidor web (padrão 3000 em server.ts, 0=aleatória em Electron)
# PORT=3000

# NFVIEW_DB_PATH: Caminho customizado para sqlite.db (fallback: userData/workspace-fiscal.sqlite no Electron, ./sqlite.db no web)
# NFVIEW_DB_PATH="./sqlite.db"

# NFVIEW_STORAGE_PATH: Caminho customizado para storage de XMLs/PDFs
# NFVIEW_STORAGE_PATH="./storage"

# NODE_ENV: development | production
# NODE_ENV="development"
