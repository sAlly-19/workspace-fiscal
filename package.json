{
  "name": "workspace-fiscal",
  "productName": "Workspace Fiscal",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development node scripts/run-electron.cjs dist-electron/main.cjs",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"npm:dev:web\" \"npm:dev:electron\"",
    "build:web": "vite build",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --external:electron --sourcemap --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --packages=external --external:electron --sourcemap --outfile=dist-electron/preload.cjs",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:web && npm run build:electron && npm run build:server",
    "electron:start": "node scripts/run-electron.cjs --build",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-resizable-panels": "^4.12.3",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.10",
    "electron": "^33.2.0",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "electron@33": true,
    "esbuild@0.25": true
  }
}
